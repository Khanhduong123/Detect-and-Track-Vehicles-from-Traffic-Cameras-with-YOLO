# --- Triton Inference Server ---
# We keep configuration files (config.pbtxt) but ignore large model weights
# inside the model repository.
model_repository/**/*.onnx
model_repository/**/*.engine
model_repository/**/*.bin
model_repository/**/*.pt
model_repository/**/*.pth

