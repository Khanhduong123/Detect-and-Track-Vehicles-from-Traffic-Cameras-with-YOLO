# Central Configuration Settings for Traffic Violation Detection System Backend

# General Settings
PROJECT_NAME="Traffic Violation Detection System"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL Asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/traffic_violations"  # pragma: allowlist secret

# Redis Configuration (Cache & Celery Broker)
REDIS_URL="redis://localhost:6379/0"

# Cloud Storage Configuration (AWS S3 or GCS)
STORAGE_BUCKET_NAME="traffic-violation-evidence"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"  # pragma: allowlist secret

# AI/ML Triton Inference Server
TRITON_SERVER_URL="localhost:8001"
YOLO_MODEL_NAME="yolov8_onnx"
